# ============================================================
# Variables de configuration de Rituel (copier en .env, JAMAIS publier .env)
# Sur l'hébergeur, elles se saisissent dans « Variables d'environnement ».
# ============================================================

# Adresse publique du site, sans « / » final
SITE_URL=https://rituel.app

# --- Supabase (Project Settings → API) — projet en région Europe ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé de service : SERVEUR UNIQUEMENT, ne jamais la mettre dans une variable VITE_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Stripe (compte de la plateforme Rituel, Connect activé) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook « Événements sur les comptes connectés » → /api/public/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- E-mails (Resend) ---
RESEND_API_KEY=re_xxx
RESEND_FROM=Rituel <rdv@votre-domaine.fr>

# --- Chiffrement des données de santé (32 octets en base64) ---
# Générer UNE fois :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perdre cette clé = perdre les allergies enregistrées. La garder dans un coffre (gestionnaire de mots de passe).
SANTE_CLE=

# --- Tâches planifiées (au moins 24 caractères aléatoires) ---
CRON_SECRET=
